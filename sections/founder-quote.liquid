{% liquid
  assign image = section.settings.image
  assign quote_mark = section.settings.quote_mark
  assign quote = section.settings.quote
  assign author_name = section.settings.author_name
  assign author_role = section.settings.author_role
  assign image_position = section.settings.image_position
%}

<div
  class="founder-quote"
  style="
    --founder-quote-bg: {{ section.settings.background_color }};
    --founder-quote-mark-color: {{ section.settings.quote_mark_color }};
    --founder-quote-text-color: {{ section.settings.quote_text_color }};
    --founder-quote-name-color: {{ section.settings.author_name_color }};
    --founder-quote-role-color: {{ section.settings.author_role_color }};
    --founder-quote-max-width: {{ section.settings.content_max_width }}px;
    --founder-quote-image-width: {{ section.settings.column_width_ratio }}%;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="founder-quote__container">
    <div class="founder-quote__grid founder-quote__grid--{{ image_position }}">
      <div class="founder-quote__media">
        {% if image != blank %}
          {{
            image
            | image_url: width: 900
            | image_tag: loading: 'lazy', class: 'founder-quote__image', widths: '300,450,600,900'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'founder-quote__image founder-quote__image--placeholder' }}
        {% endif %}
      </div>
      <div class="founder-quote__content">
        {% if quote_mark != blank %}
          <p class="founder-quote__mark">{{ quote_mark }}</p>
        {% endif %}
        {% if quote != blank %}
          <blockquote class="founder-quote__text">{{ quote }}</blockquote>
        {% endif %}
        {% if author_name != blank or author_role != blank %}
          <div class="founder-quote__author">
            {% if author_name != blank %}
              <p class="founder-quote__author-name">{{ author_name }}</p>
            {% endif %}
            {% if author_role != blank %}
              <p class="founder-quote__author-role">{{ author_role }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .founder-quote {
    display: block;
    width: 100%;
    background-color: var(--founder-quote-bg);
  }

  .founder-quote__container {
    max-width: var(--founder-quote-max-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  @media screen and (min-width: 750px) {
    .founder-quote__container {
      padding-inline: 40px;
    }
  }

  .founder-quote__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .founder-quote__grid {
      grid-template-columns: var(--founder-quote-image-width, 1fr) 1fr;
      gap: 64px;
    }

    .founder-quote__grid--right {
      grid-template-columns: 1fr var(--founder-quote-image-width, 1fr);
    }

    .founder-quote__grid--right .founder-quote__media {
      order: 2;
    }

    .founder-quote__grid--right .founder-quote__content {
      order: 1;
    }
  }

  .founder-quote__media {
    width: 100%;
  }

  .founder-quote__image,
  .founder-quote__image--placeholder {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .founder-quote__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .founder-quote__mark {
    margin: 0 0 12px;
    color: var(--founder-quote-mark-color);
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
  }

  .founder-quote__text {
    margin: 0 0 24px;
    color: var(--founder-quote-text-color);
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .founder-quote__author-name {
    margin: 0;
    color: var(--founder-quote-name-color);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .founder-quote__author-role {
    margin: 4px 0 0;
    color: var(--founder-quote-role-color);
    font-size: 0.8rem;
    max-width: 140px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cita de la fundadora",
  "tag": "section",
  "class": "founder-quote-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posicion de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "column_width_ratio",
      "label": "Ancho de la imagen",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "quote_mark",
      "label": "Simbolo de cita",
      "default": "99"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Cita",
      "default": "<p>El verdadero lujo reside en la atencion al detalle. Funde Hilvana para crear prendas que no solo se vistan, sino que se sientan; donde cada hilo cuenta una historia de innovacion y respeto por la artesania.</p>"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Nombre",
      "default": "Elena Valdes"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Cargo",
      "default": "Fundadora & Directora Creativa"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de la seccion",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "quote_mark_color",
      "label": "Color del simbolo de cita",
      "default": "#2D4B44"
    },
    {
      "type": "color",
      "id": "quote_text_color",
      "label": "Color de la cita",
      "default": "#2D4B44"
    },
    {
      "type": "color",
      "id": "author_name_color",
      "label": "Color del nombre",
      "default": "#2D4B44"
    },
    {
      "type": "color",
      "id": "author_role_color",
      "label": "Color del cargo",
      "default": "#9C4334"
    },
    {
      "type": "header",
      "content": "Diseno"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho maximo de la seccion",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Espaciado de la seccion"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Cita de la fundadora",
      "category": "Texto"
    }
  ]
}
{% endschema %}
