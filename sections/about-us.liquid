{% liquid
  assign image = section.settings.image
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign link_label = section.settings.link_label
  assign link_url = section.settings.link_url
  assign image_position = section.settings.image_position
  assign items_align = 'flex-start'
  if section.settings.text_alignment == 'center'
    assign items_align = 'center'
  endif
%}

<div
  class="about-us"
  style="
    --about-us-bg: {{ section.settings.background_color }};
    --about-us-label-color: {{ section.settings.label_color }};
    --about-us-heading-color: {{ section.settings.heading_color }};
    --about-us-text-color: {{ section.settings.text_color }};
    --about-us-link-color: {{ section.settings.link_color }};
    --about-us-max-width: {{ section.settings.content_max_width }}px;
    --about-us-image-ratio: {{ section.settings.image_ratio }};
    --about-us-image-radius: {{ section.settings.image_border_radius }}px;
    --about-us-image-position: {{ section.settings.image_object_position }};
    --about-us-image-width: {{ section.settings.column_width_ratio }}%;
    --about-us-content-align: {{ section.settings.content_vertical_alignment }};
    --about-us-text-align: {{ section.settings.text_alignment }};
    --about-us-items-align: {{ items_align }};
    --about-us-content-gap: {{ section.settings.content_gap }}px;
    --about-us-heading-size: {{ section.settings.heading_font_size }}px;
    --about-us-description-size: {{ section.settings.description_font_size }}px;
    --about-us-label-spacing: {{ section.settings.label_letter_spacing }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="about-us__container">
    <div class="about-us__grid about-us__grid--{{ image_position }}">
      <div class="about-us__media">
        {% liquid
          assign image_class = 'about-us__image'
          if section.settings.image_shadow
            assign image_class = image_class | append: ' about-us__image--shadow'
          endif
        %}
        {% if image != blank %}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: image_class,
              widths: '400,600,900,1200'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: image_class | append: ' about-us__image--placeholder' }}
        {% endif %}
      </div>
      <div class="about-us__content">
        {% if label != blank %}
          <p class="about-us__label{% if section.settings.label_uppercase %} about-us__label--uppercase{% endif %}">
            {{ label }}
          </p>
        {% endif %}
        {% if heading != blank %}
          <h2 class="about-us__heading">{{ heading }}</h2>
        {% endif %}
        {% if description != blank %}
          <div class="about-us__description">{{ description }}</div>
        {% endif %}
        {% if link_label != blank %}
          <a href="{{ link_url | default: '#' }}" class="about-us__link">
            {{ link_label }}
            {% if section.settings.show_arrow %}
              <span class="about-us__link-arrow" aria-hidden="true">&rarr;</span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .about-us {
    display: block;
    width: 100%;
    background-color: var(--about-us-bg);
  }

  .about-us__container {
    max-width: var(--about-us-max-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  @media screen and (min-width: 750px) {
    .about-us__container {
      padding-inline: 40px;
    }
  }

  .about-us__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .about-us__grid {
      grid-template-columns: var(--about-us-image-width, 1fr) 1fr;
      align-items: var(--about-us-content-align, center);
      gap: 72px;
    }

    .about-us__grid--right {
      grid-template-columns: 1fr var(--about-us-image-width, 1fr);
    }

    .about-us__grid--right .about-us__media {
      order: 2;
    }

    .about-us__grid--right .about-us__content {
      order: 1;
    }
  }

  .about-us__media {
    width: 100%;
    align-self: var(--about-us-content-align, center);
  }

  .about-us__image,
  .about-us__image--placeholder {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: var(--about-us-image-ratio, auto);
    object-position: var(--about-us-image-position, center);
    border-radius: var(--about-us-image-radius, 0);
  }

  .about-us__image--shadow {
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.35);
  }

  .about-us__content {
    display: flex;
    flex-direction: column;
    align-items: var(--about-us-items-align, flex-start);
    text-align: var(--about-us-text-align, left);
    gap: var(--about-us-content-gap, 16px);
  }

  .about-us__content > * {
    margin: 0;
  }

  .about-us__label {
    color: var(--about-us-label-color);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--about-us-label-spacing, 1.5px);
  }

  .about-us__label--uppercase {
    text-transform: uppercase;
  }

  .about-us__heading {
    color: var(--about-us-heading-color);
    font-family: var(--font-heading--family);
    font-size: var(--about-us-heading-size);
  }

  .about-us__description {
    color: var(--about-us-text-color);
    font-size: var(--about-us-description-size);
    line-height: 1.7;
  }

  .about-us__description p {
    margin: 0 0 16px;
  }

  .about-us__description p:last-child {
    margin-bottom: 0;
  }

  .about-us__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--about-us-link-color);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .about-us__link:hover .about-us__link-arrow {
    transform: translateX(4px);
  }

  .about-us__link-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sobre nosotros",
  "tag": "section",
  "class": "about-us-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posicion de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "column_width_ratio",
      "label": "Ancho de la imagen",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporcion de la imagen",
      "options": [
        { "value": "auto", "label": "Automatica (original)" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Retrato" },
        { "value": "3 / 4", "label": "Retrato alto" },
        { "value": "16 / 9", "label": "Panoramica" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "image_object_position",
      "label": "Encuadre de la imagen",
      "options": [
        { "value": "top", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "image_shadow",
      "label": "Sombra bajo la imagen",
      "default": false
    },
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineacion del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Alineacion vertical",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Espacio entre elementos de texto",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "label_uppercase",
      "label": "Etiqueta en mayusculas",
      "default": true
    },
    {
      "type": "range",
      "id": "label_letter_spacing",
      "label": "Espaciado entre letras de la etiqueta",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Tamano del titulo",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Tamano del texto",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "NUESTRA HISTORIA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "El Arte de la Precision"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripcion",
      "default": "<p>Hilvana nacio de la fusion entre el respeto por las tecnicas tradicionales y las posibilidades de la tecnologia moderna. En nuestro taller, cada diseño comienza como un trazo en papel antes de ser digitalizado con extremo cuidado.</p><p>Creemos que el bordado a maquina no es una produccion en masa, sino una herramienta que, guiada por manos expertas, permite crear piezas de una riqueza visual y tactil inigualable. Nuestra filosofia se basa en la durabilidad, la belleza sutil y el consumo consciente.</p>"
    },
    {
      "type": "header",
      "content": "Enlace"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Conoce mas sobre nosotros"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Enlace"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Mostrar flecha",
      "default": true
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de la seccion",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color de la etiqueta",
      "default": "#B0708A"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del titulo",
      "default": "#2F3B2F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#5A5A52"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color del enlace",
      "default": "#5C6B47"
    },
    {
      "type": "header",
      "content": "Diseno"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho maximo de la seccion",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Espaciado de la seccion"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Sobre nosotros",
      "category": "Texto"
    }
  ]
}
{% endschema %}
