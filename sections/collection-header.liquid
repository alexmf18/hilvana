{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign alignment = section.settings.alignment
%}

<div
  class="collection-header"
  style="
    --collection-header-bg: {{ section.settings.background_color }};
    --collection-header-heading-color: {{ section.settings.heading_color }};
    --collection-header-text-color: {{ section.settings.text_color }};
    --collection-header-max-width: {{ section.settings.content_max_width }}px;
    --collection-header-align: {{ alignment }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="collection-header__container">
    {% if heading != blank %}
      <h1 class="collection-header__heading">
        {{ heading | default: collection.title }}
      </h1>
    {% endif %}
    {% if description != blank %}
      <div class="collection-header__description">
        {{ description | default: collection.description }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .collection-header {
    display: block;
    width: 100%;
    background-color: var(--collection-header-bg);
  }

  .collection-header__container {
    max-width: var(--collection-header-max-width);
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: var(--collection-header-align);
  }

  .collection-header[style*='--collection-header-align: left'] .collection-header__container {
    align-items: flex-start;
  }

  .collection-header[style*='--collection-header-align: right'] .collection-header__container {
    align-items: flex-end;
  }

  @media screen and (min-width: 750px) {
    .collection-header__container {
      padding-inline: 40px;
    }
  }

  .collection-header__heading {
    margin: 0;
    color: var(--collection-header-heading-color);
    font-family: var(--font-heading--family);
  }

  .collection-header__description {
    margin: 0;
    color: var(--collection-header-text-color);
    line-height: 1.6;
    max-width: 640px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Encabezado de colección",
  "tag": "section",
  "class": "collection-header-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "info": "Si se deja vacio, usa el nombre de la coleccion",
      "default": "Nuestra Colección"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripcion",
      "info": "Si se deja vacio, usa la descripcion de la coleccion",
      "default": "<p>Explora nuestra cuidada selección de piezas bordadas. Cada puntada cuenta una historia, combinando la tradición artesanal con el minimalismo moderno.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineacion",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de la seccion",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del titulo",
      "default": "#2D4B44"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de la descripcion",
      "default": "#5C6B47"
    },
    {
      "type": "header",
      "content": "Diseno"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho maximo de la seccion",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Espaciado de la seccion"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Encabezado de colección",
      "category": "Colección"
    }
  ]
}
{% endschema %}
