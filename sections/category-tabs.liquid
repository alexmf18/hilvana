<div
  class="category-tabs"
  style="
    --category-tabs-bg: {{ section.settings.background_color }};
    --category-tabs-color: {{ section.settings.tab_color }};
    --category-tabs-active-color: {{ section.settings.active_tab_color }};
    --category-tabs-max-width: {{ section.settings.content_max_width }}px;
    --category-tabs-gap: {{ section.settings.gap }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="category-tabs__container">
    <nav class="category-tabs__list" aria-label="Categorías">
      {% for block in section.blocks %}
        {% liquid
          assign is_active = false
          if block.settings.link != blank and block.settings.link == request.path
            assign is_active = true
          endif
          if block.settings.mark_active
            assign is_active = true
          endif
        %}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="category-tabs__item{% if is_active %} category-tabs__item--active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </a>
      {% endfor %}
    </nav>
  </div>
</div>

{% stylesheet %}
  .category-tabs {
    display: block;
    width: 100%;
    background-color: var(--category-tabs-bg);
  }

  .category-tabs__container {
    max-width: var(--category-tabs-max-width);
    margin-inline: auto;
    padding-inline: 24px;
  }

  @media screen and (min-width: 750px) {
    .category-tabs__container {
      padding-inline: 40px;
    }
  }

  .category-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--category-tabs-gap);
  }

  .category-tabs__item {
    color: var(--category-tabs-color);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding-block-end: 4px;
    border-bottom: 2px solid transparent;
  }

  .category-tabs__item:hover {
    color: var(--category-tabs-active-color);
  }

  .category-tabs__item--active {
    color: var(--category-tabs-active-color);
    border-bottom-color: var(--category-tabs-active-color);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pestañas de categoría",
  "tag": "section",
  "class": "category-tabs-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de la sección",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Color de pestaña",
      "default": "#5A5A52"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Color de pestaña activa",
      "default": "#2D4B44"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre pestañas",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo de la sección",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Espaciado de la sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Categoría"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (colección)"
        },
        {
          "type": "checkbox",
          "id": "mark_active",
          "label": "Marcar como activa",
          "default": false,
          "info": "Se activa también automáticamente si el enlace coincide con la página actual."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pestañas de categoría",
      "category": "Colección",
      "blocks": [
        { "type": "tab", "settings": { "label": "Todas", "mark_active": true } },
        { "type": "tab", "settings": { "label": "Camisetas" } },
        { "type": "tab", "settings": { "label": "Sudaderas" } },
        { "type": "tab", "settings": { "label": "Tote Bags" } }
      ]
    }
  ]
}
{% endschema %}
