{% liquid
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color
  assign accent_color = section.settings.accent_color
  assign title_color = section.settings.title_color
  assign price_color = section.settings.price_color
  assign image_ratio = section.settings.image_ratio
%}

<div
  class="featured-showcase"
  style="
    --featured-showcase-heading-color: {{ heading_color }};
    --featured-showcase-accent-color: {{ accent_color }};
    --featured-showcase-title-color: {{ title_color }};
    --featured-showcase-price-color: {{ price_color }};
    --featured-showcase-ratio: {{ image_ratio }};
    --featured-showcase-columns-gap: {{ section.settings.columns_gap }}px;
    --featured-showcase-rows-gap: {{ section.settings.rows_gap }}px;
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  "
>
  {% if heading != blank %}
    <div class="featured-showcase__header">
      <h2 class="featured-showcase__heading">{{ heading }}</h2>
      <span class="featured-showcase__accent" aria-hidden="true"></span>
    </div>
  {% endif %}

  <div class="featured-showcase__grid">
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
      %}
      <a
        href="{% if product != blank %}{{ product.url }}{% else %}#{% endif %}"
        class="featured-showcase__item"
        {{ block.shopify_attributes }}
      >
        <div class="featured-showcase__image-wrap">
          {% if product.featured_image != blank %}
            {{
              product.featured_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', class: 'featured-showcase__image', widths: '400,600,900'
            }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'featured-showcase__image featured-showcase__image--placeholder' }}
          {% endif %}
        </div>
        <div class="featured-showcase__info">
          <p class="featured-showcase__title">
            {% if product != blank %}{{ product.title }}{% else %}Selecciona un producto{% endif %}
          </p>
          {% if product != blank %}
            <p class="featured-showcase__price">
              {%- if product.price_varies -%}
                Desde {{ product.price_min | money }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            </p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .featured-showcase {
    display: block;
    width: 100%;
  }

  .featured-showcase__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    margin-block-end: 32px;
  }

  .featured-showcase__heading {
    color: var(--featured-showcase-heading-color);
    font-family: var(--font-heading--family);
    margin: 0;
  }

  .featured-showcase__accent {
    display: block;
    width: 56px;
    height: 2px;
    background-color: var(--featured-showcase-accent-color);
  }

  .featured-showcase__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    column-gap: var(--featured-showcase-columns-gap);
    row-gap: var(--featured-showcase-rows-gap);
  }

  .featured-showcase__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    grid-column: span 3;
  }

  .featured-showcase__item:nth-child(-n + 3) {
    grid-column: span 2;
  }

  .featured-showcase__item:nth-child(n + 4) {
    grid-column: span 3;
  }

  .featured-showcase__image-wrap {
    display: block;
    width: 100%;
    aspect-ratio: var(--featured-showcase-ratio);
    overflow: hidden;
    background-color: #00000010;
  }

  .featured-showcase__image,
  .featured-showcase__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .featured-showcase__item:hover .featured-showcase__image {
    transform: scale(1.03);
  }

  .featured-showcase__info {
    margin-block-start: 12px;
  }

  .featured-showcase__title {
    margin: 0;
    color: var(--featured-showcase-title-color);
    font-size: 1rem;
    font-weight: 500;
  }

  .featured-showcase__item:hover .featured-showcase__title {
    text-decoration: underline;
  }

  .featured-showcase__price {
    margin: 4px 0 0;
    color: var(--featured-showcase-price-color);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 749px) {
    .featured-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-showcase__item,
    .featured-showcase__item:nth-child(-n + 3),
    .featured-showcase__item:nth-child(n + 4) {
      grid-column: span 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colección destacada",
  "tag": "section",
  "class": "featured-showcase-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Coleccion Destacada"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del titulo",
      "default": "#2B2B2B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de la linea decorativa",
      "default": "#B08A5A"
    },
    {
      "type": "header",
      "content": "Productos"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporcion de imagen",
      "options": [
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Retrato" },
        { "value": "3 / 4", "label": "Retrato alto" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del nombre del producto",
      "default": "#B08A5A"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color del precio",
      "default": "#6B6B6B"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Espacio horizontal",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Espacio vertical",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Espaciado de la seccion"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colección destacada",
      "category": "Productos",
      "settings": {
        "heading": "Colección Destacada"
      },
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
